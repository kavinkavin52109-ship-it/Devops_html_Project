pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/kavinkavin52109-ship-it/Devops_html_Project.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building HTML application...'
                sh 'ls -la'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application...'
                sh 'test -f index.html'
            }
        }
        stage('Docker Build') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t devops-html-project:latest .'
            }
        }

        stage('Docker Run') {
            steps {
                echo 'Starting Docker container...'
                sh '''
                    docker rm -f devops-html-container || true
                    docker run -d \
                        --name devops-html-container \
                        -p 8081:80 \
                        devops-html-project:latest
                '''
            }
        }
    }
}
